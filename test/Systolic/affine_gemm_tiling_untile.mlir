// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true" \
// RUN:   -split-input-file %s 2>/dev/null | FileCheck %s --check-prefix=STRICT
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true" \
// RUN:   -split-input-file %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=SREMARK
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true allow-fp-reassociation=true" \
// RUN:   -split-input-file %s 2>/dev/null | FileCheck %s
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true allow-fp-reassociation=true" \
// RUN:   -split-input-file %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=REMARK
//
// S5.3 (docs/AFFINE_GEMM_MAPPING.md section 26.3): a loop tiling the program writes with a
// min-clipped last tile is untiled by the lowering pass -- tile loops dropped, each point loop
// run over its whole range in place -- only when (1) every tile-shaped loop is a tiling,
// (2) the tiles run every point of the logical box exactly once (S5.2's exact coverage), and
// (3) the untiled order reorders no dependent iterations; then the box pipeline decides the
// nest. Otherwise the nest stays as written, with the reason, and is not lowered.
// Before S5.3 every such nest stayed on the host: "no static normalized extent" when the tile
// loop is outermost, no remark at all when it is not.
// Generated by gen_test53.py: every decision, range, counterexample and M x N x K below was
// computed by ENUMERATING the nest's iterations (coverage, and the order of the updates of each
// C element), not taken from the compiler. The bodies carry no fast-math flag: under strict
// floating point every nest stays on the host (STRICT, SREMARK); with allow-fp-reassociation the
// untiled ones are lowered (CHECK, REMARK). Each case was also executed (CPU reference against
// the compiled output on the soft runtime model) -- see the S5.3 report.

// m_outer: M-only tiling, tile loop outermost, min boundary, 17 = 2 x 8 + 1
//   oracle: untiled
// STRICT-LABEL: func.func @m_outer
// STRICT: affine.for %{{[a-z0-9]+}} = 0 to 17 {
// STRICT-NEXT: affine.for %{{[a-z0-9]+}} = 0 to 19 {
// STRICT-NEXT: affine.for %{{[a-z0-9]+}} = 0 to 23 {
// STRICT-NEXT: affine.load
// STRICT-NOT: systolic.matmul_tile
// CHECK-LABEL: func.func @m_outer
// CHECK: systolic.matmul_tile
// SREMARK: remark: affine multiply-accumulate nest: loop tiling as written untiled (docs/AFFINE_GEMM_MAPPING.md section 26.3): tile loop 0 (T = 8) dropped, point loop 1 runs [0, 17) (last tile 1 of 8); every point of the logical box is run by exactly one iteration (exact, Presburger); the order of the iterations is kept
// SREMARK: remark: affine GEMM not lowered to systolic.matmul_tile: floating-point reassociation is not permitted
// REMARK: remark: affine multiply-accumulate nest: loop tiling as written untiled (docs/AFFINE_GEMM_MAPPING.md section 26.3): tile loop 0 (T = 8) dropped, point loop 1 runs [0, 17) (last tile 1 of 8); every point of the logical box is run by exactly one iteration (exact, Presburger); the order of the iterations is kept
// REMARK: remark: affine GEMM 17x19x23 lowered as
func.func @m_outer(%A: memref<17x23xf32> {llvm.noalias}, %B: memref<23x19xf32> {llvm.noalias}, %C: memref<17x19xf32> {llvm.noalias}) {
  affine.for %ii = 0 to 17 step 8 {
    affine.for %i = affine_map<(d0) -> (d0)>(%ii) to min affine_map<(d0) -> (d0 + 8, 17)>(%ii) {
      affine.for %j = 0 to 19 {
        affine.for %k = 0 to 23 {
          %a = affine.load %A[%i, %k] : memref<17x23xf32>
          %b = affine.load %B[%k, %j] : memref<23x19xf32>
          %c = affine.load %C[%i, %j] : memref<17x19xf32>
          %p = arith.mulf %a, %b : f32
          %s = arith.addf %c, %p : f32
          affine.store %s, %C[%i, %j] : memref<17x19xf32>
        }
      }
    }
  }
  return
}

// -----

// m_mid: M-only tiling, tile loop not outermost (inside j), next to its point loop
//   oracle: untiled
// STRICT-LABEL: func.func @m_mid
// STRICT: affine.for %{{[a-z0-9]+}} = 0 to 19 {
// STRICT-NEXT: affine.for %{{[a-z0-9]+}} = 0 to 17 {
// STRICT-NEXT: affine.for %{{[a-z0-9]+}} = 0 to 23 {
// STRICT-NEXT: affine.load
// STRICT-NOT: systolic.matmul_tile
// CHECK-LABEL: func.func @m_mid
// CHECK: systolic.matmul_tile
// SREMARK: remark: affine multiply-accumulate nest: loop tiling as written untiled (docs/AFFINE_GEMM_MAPPING.md section 26.3): tile loop 1 (T = 8) dropped, point loop 2 runs [0, 17) (last tile 1 of 8); every point of the logical box is run by exactly one iteration (exact, Presburger); the order of the iterations is kept
// SREMARK: remark: affine GEMM not lowered to systolic.matmul_tile: floating-point reassociation is not permitted
// REMARK: remark: affine multiply-accumulate nest: loop tiling as written untiled (docs/AFFINE_GEMM_MAPPING.md section 26.3): tile loop 1 (T = 8) dropped, point loop 2 runs [0, 17) (last tile 1 of 8); every point of the logical box is run by exactly one iteration (exact, Presburger); the order of the iterations is kept
// REMARK: remark: affine GEMM 17x19x23 lowered as
func.func @m_mid(%A: memref<17x23xf32> {llvm.noalias}, %B: memref<23x19xf32> {llvm.noalias}, %C: memref<17x19xf32> {llvm.noalias}) {
  affine.for %j = 0 to 19 {
    affine.for %ii = 0 to 17 step 8 {
      affine.for %i = affine_map<(d0) -> (d0)>(%ii) to min affine_map<(d0) -> (d0 + 8, 17)>(%ii) {
        affine.for %k = 0 to 23 {
          %a = affine.load %A[%i, %k] : memref<17x23xf32>
          %b = affine.load %B[%k, %j] : memref<23x19xf32>
          %c = affine.load %C[%i, %j] : memref<17x19xf32>
          %p = arith.mulf %a, %b : f32
          %s = arith.addf %c, %p : f32
          affine.store %s, %C[%i, %j] : memref<17x19xf32>
        }
      }
    }
  }
  return
}

