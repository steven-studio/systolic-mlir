// RUN: systolic-opt --test-affine-matmul-discovery -split-input-file %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=DISC
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true" \
// RUN:   -split-input-file %s 2>/dev/null | FileCheck %s --check-prefix=STRICT
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true" \
// RUN:   -split-input-file %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=SREMARK
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true allow-fp-reassociation=true" \
// RUN:   -split-input-file %s 2>/dev/null | FileCheck %s
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true allow-fp-reassociation=true" \
// RUN:   -split-input-file %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=REMARK
//
// S5.4 (docs/AFFINE_GEMM_MAPPING.md section 26.4): the legality of untiling a written loop
// tiling, layer by layer -- pattern, coverage, dependence, execution order, the untiling --
// with the classes of section 9; recognition is not legality, and legality is not lowering.
// One expected line per nest is checked against BOTH the discovery pass (DISC) and the
// lowering pass in strict (SREMARK) and reassociating (REMARK) mode: the two passes decide
// with one function and must print the same classes. The bodies carry no fast-math flag:
// under strict floating point nothing is lowered (STRICT); with allow-fp-reassociation the
// legal ones are (CHECK).
// Generated by gen_test54.py: every class below was computed by ENUMERATING the nest (the
// coverage of its tiles; per element of C, C[i][j] or the rank-1 C[i + j], whether the
// program's sequence of updates stays increasing in the untiled order) and the rules of
// section 26.4 -- not taken from the compiler. Each nest was also executed (CPU reference
// against the compiled output on the soft runtime model).

// legal_untiled: an existing legal GEMM, not tiled
// DISC-LABEL: candidate count
// DISC-NOT: scope:
// DISC-NOT: tiling legality
// SREMARK-NOT: tiling legality
// REMARK-NOT: tiling legality
// STRICT-LABEL: func.func @legal_untiled
// STRICT-NOT: systolic.matmul_tile
// CHECK-LABEL: func.func @legal_untiled
// CHECK: systolic.matmul_tile
func.func @legal_untiled(%A: memref<17x23xf32> {llvm.noalias}, %B: memref<23x19xf32> {llvm.noalias}, %C: memref<17x19xf32> {llvm.noalias}) {
  affine.for %i = 0 to 17 {
    affine.for %j = 0 to 19 {
      affine.for %k = 0 to 23 {
        %a = affine.load %A[%i, %k] : memref<17x23xf32>
        %b = affine.load %B[%k, %j] : memref<23x19xf32>
        %c = affine.load %C[%i, %j] : memref<17x19xf32>
        %p = arith.mulf %a, %b : f32
        %s = arith.addf %c, %p : f32
        affine.store %s, %C[%i, %j] : memref<17x19xf32>
      }
    }
  }
  return
}

// -----

// legal_divisible: a divisible tiling, left to the domain normalization (section 19.12): no tiling legality line
// DISC-LABEL: candidate count
// DISC-NOT: scope:
// DISC-NOT: tiling legality
// SREMARK-NOT: tiling legality
// REMARK-NOT: tiling legality
// STRICT-LABEL: func.func @legal_divisible
// STRICT-NOT: systolic.matmul_tile
// CHECK-LABEL: func.func @legal_divisible
// CHECK: systolic.matmul_tile
func.func @legal_divisible(%A: memref<32x23xf32> {llvm.noalias}, %B: memref<23x19xf32> {llvm.noalias}, %C: memref<32x19xf32> {llvm.noalias}) {
  affine.for %ii = 0 to 32 step 8 {
    affine.for %i = affine_map<(d0) -> (d0)>(%ii) to affine_map<(d0) -> (d0 + 8)>(%ii) {
      affine.for %j = 0 to 19 {
        affine.for %k = 0 to 23 {
          %a = affine.load %A[%i, %k] : memref<32x23xf32>
          %b = affine.load %B[%k, %j] : memref<23x19xf32>
          %c = affine.load %C[%i, %j] : memref<32x19xf32>
          %p = arith.mulf %a, %b : f32
          %s = arith.addf %c, %p : f32
          affine.store %s, %C[%i, %j] : memref<32x19xf32>
        }
      }
    }
  }
  return
}

