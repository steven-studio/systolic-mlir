// RUN: systolic-opt --test-affine-matmul-discovery %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=DEFAULT
// RUN: systolic-opt "--affine-matmul-to-systolic=classify=true allow-fp-reassociation=true" %s 2>&1 \
// RUN:   | FileCheck %s --check-prefixes=DEFAULT,DEFAULT-IR
// RUN: systolic-opt "--test-affine-matmul-discovery=assume-no-alias=true" %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=ASSUMED
// RUN: systolic-opt "--affine-matmul-to-systolic=report=true classify=true allow-fp-reassociation=true assume-no-alias=true" %s 2>&1 \
// RUN:   | FileCheck %s --check-prefixes=ASSUMED,ASSUMED-IR
//
// S5.4 (docs section 26.4): the tiling legality depends on assume-no-alias (the alias rule of
// the dependence test), and the discovery pass decides it with the same option as the
// lowering pass. Without llvm.noalias, untiling this K tiling (i and j between the tile loop
// and its point loop) is UNKNOWN; with assume-no-alias=true it is PROVEN_VALID and performed.
// Generated by gen_test54.py (classes by enumeration).
// DEFAULT: tiling legality ({{.*}}): pattern: every tile-shaped loop is a tiling of the form section 26.1 records; coverage: PROVEN_VALID; dependence: UNKNOWN; execution order: UNKNOWN; untiling: UNKNOWN (not performed); lowering: not through an untiling, the box pipeline decides the nest as written
// DEFAULT-IR-NOT: = systolic.matmul_tile
// ASSUMED: tiling legality ({{.*}}): pattern: every tile-shaped loop is a tiling of the form section 26.1 records; coverage: PROVEN_VALID; dependence: PROVEN_VALID (exact dependence test); execution order: PROVEN_VALID (every element of C accumulates in the program's order); untiling: PROVEN_VALID (performed); lowering: decided by the box pipeline on the untiled nest
// ASSUMED-IR: = systolic.matmul_tile
func.func @alias_option(%A: memref<17x23xf32>, %B: memref<23x19xf32>, %C: memref<17x19xf32>) {
  affine.for %kk = 0 to 23 step 16 {
    affine.for %i = 0 to 17 {
      affine.for %j = 0 to 19 {
        affine.for %k = affine_map<(d0) -> (d0)>(%kk) to min affine_map<(d0) -> (d0 + 16, 23)>(%kk) {
          %a = affine.load %A[%i, %k] : memref<17x23xf32>
          %b = affine.load %B[%k, %j] : memref<23x19xf32>
          %c = affine.load %C[%i, %j] : memref<17x19xf32>
          %p = arith.mulf %a, %b : f32
          %s = arith.addf %c, %p : f32
          affine.store %s, %C[%i, %j] : memref<17x19xf32>
        }
      }
    }
  }
  return
}
