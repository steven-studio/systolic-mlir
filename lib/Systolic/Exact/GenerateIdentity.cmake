# Writes SolverIdentity.inc, run on every build by the SystolicExactIdentity
# target so that the recorded state is the state being built. The file is only
# replaced when its content changes, so an unchanged tree rebuilds nothing.
#
# A field that cannot be established is written as UNKNOWN. Nothing is guessed.
#
# Every repository here is only read. A plain `git status` takes the index lock
# and may rewrite the index, hence --no-optional-locks. `git diff` refreshes the
# index even with that option, so it is given a copy to refresh.
#
# usage: cmake -DCONFIG=<IdentityConfig.cmake> -P GenerateIdentity.cmake

cmake_minimum_required(VERSION 3.20)
include(${CONFIG})

# Whether `directory` is the top of a repository. git looks upward, so without
# this a tree unpacked inside some other repository, a build directory for one,
# would be described by that repository's state.
function(is_repository_top directory result)
  set(${result} FALSE PARENT_SCOPE)
  if(GIT AND IS_DIRECTORY "${directory}")
    execute_process(COMMAND ${GIT} -C ${directory} rev-parse --show-prefix
                    RESULT_VARIABLE rc OUTPUT_VARIABLE prefix ERROR_QUIET
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(rc EQUAL 0 AND "${prefix}" STREQUAL "")
      set(${result} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# The fingerprint of the solver's sources: the SHA-256 of what `sha256sum` prints
# for them in sorted order, by repository path.
file(GLOB files RELATIVE ${SOURCE_ROOT}
     ${SOURCE_ROOT}/include/Systolic/Exact/* ${SOURCE_ROOT}/lib/Systolic/Exact/*)
list(SORT files)
set(lines "")
foreach(path ${files})
  file(SHA256 ${SOURCE_ROOT}/${path} hash)
  string(APPEND lines "${hash}  ${path}\n")
endforeach()
string(SHA256 sourceFingerprint "${lines}")

# The project.
set(projectCommit UNKNOWN)
set(projectTree Unknown)
set(projectDiff UNKNOWN)
is_repository_top("${SOURCE_ROOT}" projectIsTop)
if(projectIsTop)
  execute_process(COMMAND ${GIT} -C ${SOURCE_ROOT} rev-parse --verify HEAD
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET
                  OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc EQUAL 0 AND out MATCHES "^[0-9a-f]+$")
    set(projectCommit ${out})
    execute_process(COMMAND ${GIT} --no-optional-locks -C ${SOURCE_ROOT} status
                            --porcelain
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET)
    if(rc EQUAL 0)
      if("${out}" STREQUAL "")
        set(projectTree Clean)
      else()
        set(projectTree Dirty)
      endif()
    endif()
    execute_process(COMMAND ${GIT} -C ${SOURCE_ROOT} rev-parse
                            --path-format=absolute --git-path index
                    RESULT_VARIABLE rc OUTPUT_VARIABLE index ERROR_QUIET
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(rc EQUAL 0 AND EXISTS "${index}")
      configure_file("${index}" "${OUTPUT}.index" COPYONLY)
      set(ENV{GIT_INDEX_FILE} "${OUTPUT}.index")
      execute_process(COMMAND ${GIT} -C ${SOURCE_ROOT} diff
                      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET)
      unset(ENV{GIT_INDEX_FILE})
      file(REMOVE "${OUTPUT}.index")
      if(rc EQUAL 0)
        string(SHA256 projectDiff "${out}")
      endif()
    endif()
  endif()
endif()

# LLVM. The revision comes from the build tree. The source tree can only speak
# for it when it sits at that revision, so any other case stays Unknown.
set(patchStatus Unknown)
set(llvmRevision "")
if(EXISTS "${VCS_HEADER}")
  file(STRINGS "${VCS_HEADER}" line REGEX "define LLVM_REVISION")
  if(line MATCHES "\\(([0-9a-f]+)\\)")
    set(llvmRevision ${CMAKE_MATCH_1})
  endif()
endif()
is_repository_top("${LLVM_SOURCE_DIR}" llvmIsTop)
if(llvmIsTop AND llvmRevision)
  execute_process(COMMAND ${GIT} -C ${LLVM_SOURCE_DIR} rev-parse --verify HEAD
                  RESULT_VARIABLE rc OUTPUT_VARIABLE head ERROR_QUIET
                  OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc EQUAL 0 AND head STREQUAL llvmRevision)
    string(REPLACE " " ";" scope "${LLVM_PATCH_SCOPE}")
    execute_process(COMMAND ${GIT} --no-optional-locks -C ${LLVM_SOURCE_DIR}
                            status --porcelain --
                            ${scope}
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET)
    if(rc EQUAL 0)
      if("${out}" STREQUAL "")
        set(patchStatus NoneVerified)
      else()
        set(patchStatus Patched)
      endif()
    endif()
  endif()
endif()

set(text "// Generated by GenerateIdentity.cmake. Do not edit.\n")
foreach(pair
        "SOURCE_SHA256=${sourceFingerprint}"
        "PROJECT_COMMIT=${projectCommit}"
        "PROJECT_DIFF_SHA256=${projectDiff}"
        "LLVM_PATCH_SCOPE=${LLVM_PATCH_SCOPE}"
        "LLVM_SOURCE_DIR=${LLVM_SOURCE_DIR}"
        "COMPILER_ID=${COMPILER_ID}"
        "COMPILER_VERSION=${COMPILER_VERSION}"
        "BUILD_TYPE=${BUILD_TYPE}"
        "FLAGS_SHA256=${FLAGS_SHA256}")
  string(FIND "${pair}" "=" split)
  string(SUBSTRING "${pair}" 0 ${split} name)
  math(EXPR start "${split} + 1")
  string(SUBSTRING "${pair}" ${start} -1 value)
  if("${value}" STREQUAL "")
    set(value UNKNOWN)
  endif()
  string(APPEND text "#define SYSTOLIC_EXACT_${name} \"${value}\"\n")
endforeach()
string(APPEND text "#define SYSTOLIC_EXACT_PROJECT_TREE ${projectTree}\n")
string(APPEND text "#define SYSTOLIC_EXACT_LLVM_PATCH_STATUS ${patchStatus}\n")

file(WRITE ${OUTPUT}.tmp "${text}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp
                        ${OUTPUT})
file(REMOVE ${OUTPUT}.tmp)
